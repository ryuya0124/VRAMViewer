<Window
    x:Class="VramMonitor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:VramMonitor.Models"
    Title="VRAMViewer">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="WindowTitleBar" Title="VRAMViewer" />
        <StackPanel Grid.Row="1" Margin="28,12,28,16" Spacing="16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="VRAMViewer" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="Subtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="RefreshButton" Click="Refresh_Click" AutomationProperties.AutomationId="RefreshButton">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="14" /><TextBlock x:Name="RefreshText" /></StackPanel>
                    </Button>
                    <Button x:Name="SettingsButton" AutomationProperties.AutomationId="SettingsButton">
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                        <Button.Flyout><MenuFlyout>
                            <MenuFlyoutSubItem x:Name="ThemeMenu">
                                <MenuFlyoutItem x:Name="ThemeAuto" Tag="Default" Click="Theme_Click" />
                                <MenuFlyoutItem x:Name="ThemeLight" Tag="Light" Click="Theme_Click" />
                                <MenuFlyoutItem x:Name="ThemeDark" Tag="Dark" Click="Theme_Click" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem x:Name="IntervalMenu">
                                <MenuFlyoutItem Text="0.5 s" Tag="500" Click="Interval_Click" />
                                <MenuFlyoutItem Text="1 s" Tag="1000" Click="Interval_Click" />
                                <MenuFlyoutItem Text="1.5 s" Tag="1500" Click="Interval_Click" />
                                <MenuFlyoutItem Text="2 s" Tag="2000" Click="Interval_Click" />
                                <MenuFlyoutItem Text="3 s" Tag="3000" Click="Interval_Click" />
                                <MenuFlyoutItem Text="5 s" Tag="5000" Click="Interval_Click" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem x:Name="LanguageMenu" />
                            <ToggleMenuFlyoutItem x:Name="AlwaysOnTopMenu" Click="AlwaysOnTop_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="DiagnosticsMenu" Click="Diagnostics_Click" />
                            <MenuFlyoutItem x:Name="AboutMenu" Click="About_Click" />
                        </MenuFlyout></Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <ComboBox x:Name="GpuSelector" HorizontalAlignment="Stretch" SelectionChanged="Gpu_SelectionChanged" AutomationProperties.AutomationId="GpuSelector" />
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4"><TextBlock x:Name="DedicatedTitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="DedicatedValue" FontSize="22" FontWeight="SemiBold" Text="—" /></StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4"><TextBlock x:Name="SharedTitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="SharedValue" FontSize="22" FontWeight="SemiBold" Text="—" /></StackPanel>
                    </Grid>
                    <ProgressBar x:Name="MemoryProgress" Maximum="100" />
                    <TextBlock x:Name="SourceLabel" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" Severity="Informational" />
        </StackPanel>
        <Grid Grid.Row="2" Margin="28,0,28,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Padding="12,0,12,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="160" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions>
                <Button x:Name="PidColumn" Tag="0" Click="Sort_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" />
                <Button x:Name="NameColumn" Grid.Column="1" Tag="1" Click="Sort_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                <Button x:Name="DedicatedColumn" Grid.Column="2" Tag="2" Click="Sort_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" />
                <Button x:Name="SharedColumn" Grid.Column="3" Tag="3" Click="Sort_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" />
            </Grid>
            <ListView x:Name="ProcessList" Grid.Row="1" SelectionMode="Single" RightTapped="ProcessList_RightTapped" AutomationProperties.AutomationId="ProcessList">
                <ListView.ItemContainerStyle><Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="12,10" />
                    <Setter Property="Margin" Value="0,1" />
                    <Setter Property="CornerRadius" Value="6" />
                </Style></ListView.ItemContainerStyle>
                <ListView.ItemTemplate><DataTemplate x:DataType="models:ProcessDisplayRow">
                    <Grid ColumnSpacing="12" Opacity="{x:Bind RowOpacity}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="160" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind PidText}" VerticalAlignment="Center" FontFamily="Consolas" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Image Source="{x:Bind Icon, Mode=OneWay}" Width="20" Height="20" />
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind DedicatedText, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="{x:Bind SharedText, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </DataTemplate></ListView.ItemTemplate>
            </ListView>
        </Grid>
        <TextBlock x:Name="UpdatedLabel" Grid.Row="3" Margin="40,12,28,16" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Window>
